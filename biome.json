{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!.zed/settings.json",
      "!pnpm-lock.yaml",
      "!**/*.svg",
      "!.claude/skills"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "domains": {
      "next": "recommended",
      "project": "recommended",
      "react": "recommended",
      "test": "recommended",
      "types": "recommended"
    },
    "rules": {
      "correctness": {
        "useExhaustiveDependencies": "warn",
        "noUnusedImports": {
          "level": "error",
          "fix": "safe"
        },
        "noNextAsyncClientComponent": "error",
        "noBeforeInteractiveScriptOutsideDocument": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": {
          "level": "error",
          "options": {
            "style": "inlineType"
          }
        },
        "noJsxLiterals": "error",
        "useConsistentArrowReturn": "error",
        "noContinue": "error",
        "noIncrementDecrement": "error",
        "useImportsFirst": "warn"
      },
      "nursery": {
        "noMisusedPromises": "error",
        "noFloatingPromises": "error",
        "useExhaustiveSwitchCases": "error",
        "useNullishCoalescing": {
          "level": "error",
          "fix": "safe"
        },
        "useAwaitThenable": "error",
        "noUnsafePlusOperands": "warn",
        "useRegexpExec": "warn",
        "useTailwindSortedClasses": {
          "level": "error",
          "fix": "safe"
        }
      },
      "suspicious": {
        "noReactForwardRef": {
          "level": "error",
          "fix": "safe"
        },
        "noDeprecatedImports": "error",
        "noImportCycles": "error",
        "noUnusedExpressions": "error",
        "noParametersOnlyUsedInRecursion": "error",
        "noShadow": "error",
        "noUnknownAttribute": "error",
        "noUnnecessaryConditions": "error",
        "useArraySortCompare": "error",
        "noLeakedRender": "error",
        "noDuplicatedSpreadProps": "error",
        "useRequiredScripts": "error"
      },
      "complexity": {
        "noUselessCatchBinding": {
          "level": "error",
          "fix": "safe"
        },
        "noUselessUndefined": "error",
        "useArrayFind": "warn"
      },
      "performance": {
        "noSyncScripts": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "enabled": true
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    },
    "parser": {
      "tailwindDirectives": true,
      "cssModules": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none",
      "indentWidth": 2
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "preset": "recommended",
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [{ "type": false }]
          }
        },
        "useSortedProperties": "on"
      }
    }
  },
  "tailwind": { "mergeFunctions": ["clsx", "cn", "twMerge"] }
}
